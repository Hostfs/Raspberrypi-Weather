# PiWeather Raspberry Pi IoT Configuration
# DEMO_MODE: Set to "true" for simulated sensor telemetry, "false" for live Raspberry Pi hardware MQTT data
DEMO_MODE=true

# MQTT Broker Settings
# Default public test broker or replace with your local Raspberry Pi IP (e.g. 192.168.0.50)
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=piweather_android_client

# MQTT Topics
MQTT_TOPIC_TELEMETRY=rpi/weather/telemetry
MQTT_TOPIC_CONFIG=rpi/weather/config
MQTT_TOPIC_STATUS=rpi/weather/status

# Telemetry update interval in milliseconds (default 1000ms = 1 second)
TELEMETRY_INTERVAL_MS=1000
